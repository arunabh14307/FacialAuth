# Enterprise Environment Configuration Template
# Copy this file to .env and set your production values.

# Flask Application Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_ENV=production
DEBUG=False

# Face Embedding Encryption (32 url-safe base64-encoded bytes or Fernet key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database Connection (SQLite default, PostgreSQL supported e.g. postgresql://user:pass@localhost:5432/dbname)
DATABASE_URL=

# Admin Defaults (Used only on initial empty database seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@faceguard.local

# Security & Session Settings
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
REMEMBER_ME_DAYS=7

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=

# Optional HTTP Email APIs
BREVO_API_KEY=
RESEND_API_KEY=
